int pivotCount = zigZag.pivots.size()//pivotCountはピボットの個数
float avgPlus = na//表に表示させるプラスの平均、naは初期値として “値が存在しない（na）” 状態にしている
float avgMinus = na//表に表示させるマイナスの平均

// --- プラス平均（％） ---
if pivotCount >= 2
    float sumPercentPlus = 0.0
    int countPlus = 0
    int idx = pivotCount - 1

    while idx > 0 and countPlus < lookbackPlus
        Zig.Pivot p1 = zigZag.pivots.get(idx)
        Zig.Pivot p2 = zigZag.pivots.get(idx - 1)

        float diff = p1.end.price - p2.end.price

        if diff > 0
            float pct = diff / p2.end.price * 100
            sumPercentPlus += pct
            countPlus += 1

        idx -= 1

    if countPlus > 0
        avgPlus := sumPercentPlus / countPlus


// --- マイナス平均（％） ---
if pivotCount >= 2
    float sumPercentMinus = 0.0
    int countMinus = 0
    int idx2 = pivotCount - 1

    while idx2 > 0 and countMinus < lookbackMinus
        Zig.Pivot p1 = zigZag.pivots.get(idx2)
        Zig.Pivot p2 = zigZag.pivots.get(idx2 - 1)

        float diff = p1.end.price - p2.end.price

        if diff < 0
            float pct = math.abs(diff) / p2.end.price * 100
            sumPercentMinus += pct
            countMinus += 1

        idx2 -= 1

    if countMinus > 0
        avgMinus := sumPercentMinus / countMinus

// --- 現在価格に対する比率（％） ---
float percentPlus = na//
float percentMinus = na
if not na(avgPlus)//avgPlus が na のままなら割り算しない/エラー防止
    percentPlus := (avgPlus / close) * 100
if not na(avgMinus)
    percentMinus := (avgMinus / close) * 100



// --- トレンド継続判定 ---
color bgColor = color.new(color.yellow, 85)

var int trendState = 0
// 1 = 上昇トレンド
// -1 = 下降トレンド
// 0 = レンジ

if pivotCount >= 4

    float lastHigh = na
    float prevHigh = na
    float lastLow = na
    float prevLow = na

    int foundHigh = 0
    int foundLow = 0

    int i = pivotCount - 1

    while i >= 0 and (foundHigh < 2 or foundLow < 2)
        Zig.Pivot p = zigZag.pivots.get(i)

        if p.isHigh and foundHigh < 2
            if foundHigh == 0
                lastHigh := p.end.price
            else
                prevHigh := p.end.price
            foundHigh += 1

        if not p.isHigh and foundLow < 2
            if foundLow == 0
                lastLow := p.end.price
            else
                prevLow := p.end.price
            foundLow += 1

        i -= 1

    if not na(lastHigh) and not na(prevHigh) and not na(lastLow) and not na(prevLow)

        // 上昇トレンド
        if lastHigh > prevHigh and lastLow > prevLow
            trendState := 1

        // 下降トレンド
        else if lastHigh < prevHigh and lastLow < prevLow
            trendState := -1

        // それ以外
        else
            trendState := 0



// ================================
// ■ ZigZag HH / HL / LH / LL 完全版（UI干渉対策込み）
// ================================

var float lastHighPivot = na
var float lastLowPivot  = na
var int   lastProcessedTime = na

// 視覚調整（これで％テーブルと被らない）
//ハイローとピボットを同じオフセットに入れたから干渉せず表示できる
float offset = 0

//hennkou
if smallZigZag.pivots.size() > 2
//henkou
    int idx = smallZigZag.pivots.size() - 2
    //henkou
    Zig.Pivot p = smallZigZag.pivots.get(idx)

    int t = int(p.end.time)

    // 1回だけ処理（重複防止）
    if na(lastProcessedTime) or t != lastProcessedTime

        // =========================
        // ■ HIGH PIVOT
        // =========================
        if p.isHigh

            string txt = "H"

            if not na(lastHighPivot)
                txt := p.end.price > lastHighPivot ? "HH" : "LH"

            color bg = p.end.price > nz(lastHighPivot, p.end.price) ? color.green : color.red

            label.new(
                x=t,
                y=p.end.price + offset,   // ★上にずらす
                text=txt,
                xloc=xloc.bar_time,
                style=label.style_label_down,
                textcolor=color.white,
                color=bg,
                size=size.small
            )

            lastHighPivot := p.end.price

        // =========================
        // ■ LOW PIVOT
        // =========================
        else

            string txt = "L"

            if not na(lastLowPivot)
                txt := p.end.price < lastLowPivot ? "LL" : "HL"

            // HL=緑 / LL=赤 / 初回=グレー
            color bg = na(lastLowPivot) ? color.gray :
                       p.end.price < lastLowPivot ? color.red : color.green

            label.new(
                x=t,
                y=p.end.price - offset,   // ★下にずらす
                text=txt,
                xloc=xloc.bar_time,
                style=label.style_label_up,
                textcolor=color.white,
                color=bg,
                size=size.small
            )

            lastLowPivot := p.end.price

        // 更新（重複防止）
        lastProcessedTime := t



