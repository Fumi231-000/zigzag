//@version=6
indicator("ジグザグ押し目と戻り表示②", overlay=true, max_lines_count=500, max_labels_count=500)

// ライブラリのインポート
import njs05/ZigZag/1 as Zig

// --- ZigZag 設定 ---
float deviationInput = input.float(8.5, 'Deviation (%)', minval=0.00001, maxval=100.0)
int depthInput = input.int(1, 'Depth', minval=1)
color lineColorInput = input.color(#2962FF, 'Line Color')
bool extendInput = input.bool(true, 'Extend Last Pivot')
string priceDiffInput = input.string('Percent', '', options=['Absolute','Percent'])



var Zig.Settings settings = Zig.Settings.new(
    deviationInput,
    depthInput,
    lineColorInput,
    extendInput,
    false,
    false,
    false,
    "Percent")
var Zig.ZigZag zigZag = Zig.newInstance(settings)


//=========================
// ラベル設定
//=========================

string labelSizeInput = input.string(
     "Small",
     "文字サイズ",
     options=["Tiny","Small","Normal","Large","Huge"])

float labelOffset = input.float(
     0.8,
     "ラベル位置倍率",
     step=0.1)

color pullbackTextColor = input.color(
     color.orange,
     "押し目文字色")

color reboundTextColor = input.color(
     color.aqua,
     "戻り文字色")

f_getLabelSize() =>
    switch labelSizeInput
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.huge

// ================================
// 小さい波用 ZigZag (Deviation
// ================================

int bigWaveLookback = input.int(
     1,
     "8.5波の参照数",
     minval=1,
     maxval=100)

float smallDeviationInput = input.float(
     3.5,
     "Small ZigZag Deviation (%)",
     minval=0.00001,
     maxval=100)


var Zig.Settings smallSettings =
     Zig.Settings.new(
          smallDeviationInput,
          depthInput,
          color.orange,
          extendInput,
          false,
          false,
          false,
          priceDiffInput)


var Zig.ZigZag smallZigZag =
     Zig.newInstance(smallSettings)

// --- ZigZag 更新 ---
zigZag.update()
smallZigZag.update()



//変数
//=========================================
// 上昇8.5波内の押し率
//=========================================




// 押し目ラベル重複防止
var int lastPullbackLabelTime = na



int bigCount   = zigZag.pivots.size()
int smallCount = smallZigZag.pivots.size()

if bigCount >= 2 and smallCount >= 3



    int waveCount = 0
    int b = bigCount - 1

    while b > 0 and waveCount < bigWaveLookback

        Zig.Pivot bigHigh = zigZag.pivots.get(b)
        Zig.Pivot bigLow  = zigZag.pivots.get(b - 1)

        float bigMove = bigHigh.end.price - bigLow.end.price

        // 上昇8.5波だけ
        if bigMove > 0

            int startTime = int(bigLow.end.time)
            int endTime   = int(bigHigh.end.time)
            

            // 古い→新しいで走査
            int s = 1

            while s < smallCount - 1

                Zig.Pivot prevPivot = smallZigZag.pivots.get(s - 1)
                Zig.Pivot lowPivot  = smallZigZag.pivots.get(s)
                Zig.Pivot nextPivot = smallZigZag.pivots.get(s + 1)

                // 3点とも8.5波の中
                if prevPivot.end.time >= startTime and nextPivot.end.time <= endTime

                    // 高値→安値→高値
                    if prevPivot.end.price > lowPivot.end.price and nextPivot.end.price > lowPivot.end.price


                        //=========================
                        // 押し目ラベル表示
                        //=========================

                        int pullTime = int(lowPivot.end.time)


                        if na(lastPullbackLabelTime) or pullTime != lastPullbackLabelTime

                            float pullPercent =
                                 (prevPivot.end.price - lowPivot.end.price) /
                                 prevPivot.end.price * 100


                            label.new(
                                x=pullTime,
                                y=lowPivot.end.price * (1 - labelOffset / 100),
                                xloc=xloc.bar_time,
                                text="-" + str.tostring(pullPercent, "#.##") + "%",
                                textcolor=pullbackTextColor,
                                style=label.style_none,
                                color=color.new(color.white, 100),
                                size = f_getLabelSize()
                            )


                            lastPullbackLabelTime := pullTime

                      
                s += 1

            waveCount += 1

        b -= 1



//=========================================
// 下降8.5波内の戻り率
//=========================================

// 戻りラベル重複防止
var int lastReboundLabelTime = na

int bigCountDown   = zigZag.pivots.size()
int smallCountDown = smallZigZag.pivots.size()

if bigCount >= 2 and smallCount >= 3

    int waveCount = 0
    int b = bigCountDown - 1

    while b > 0 and waveCount < bigWaveLookback

        Zig.Pivot bigLow  = zigZag.pivots.get(b)
        Zig.Pivot bigHigh = zigZag.pivots.get(b - 1)

        float bigMove = bigLow.end.price - bigHigh.end.price

        // 下降8.5波だけ
        if bigMove < 0

            int startTime = int(bigHigh.end.time)
            int endTime   = int(bigLow.end.time)

            // 古い→新しい
            int s = 1

            while s < smallCountDown - 1

                Zig.Pivot prevPivot = smallZigZag.pivots.get(s - 1)
                Zig.Pivot highPivot = smallZigZag.pivots.get(s)
                Zig.Pivot nextPivot = smallZigZag.pivots.get(s + 1)

                // 3点とも8.5波の中
                if prevPivot.end.time >= startTime and nextPivot.end.time <= endTime

                    // 安値→高値→安値
                    if prevPivot.end.price < highPivot.end.price and nextPivot.end.price < highPivot.end.price

                        //=========================
                        // 戻り高値ラベル表示
                        //=========================

                        int reboundTime = int(highPivot.end.time)


                        if na(lastReboundLabelTime) or reboundTime != lastReboundLabelTime


                            float reboundPercentLabel =
                                 (highPivot.end.price - prevPivot.end.price) /
                                 prevPivot.end.price * 100


                            label.new(
                                x=reboundTime,
                                y=highPivot.end.price * (1 + labelOffset / 100),
                                xloc=xloc.bar_time,
                                text="+" + str.tostring(reboundPercentLabel, "#.##") + "%",
                                textcolor=reboundTextColor,
                                style=label.style_none,
                                color=color.new(color.white, 100),
                                size = f_getLabelSize()
                            )


                            lastReboundLabelTime := reboundTime



                        // 戻り率
                        float reboundPercent =
                             (highPivot.end.price - prevPivot.end.price) /
                             prevPivot.end.price * 100


                s += 1

            waveCount += 1

        b -= 1

//ここまでが押しと戻り


